# Google AI Studio / Gemini API Key for the "Ask Tom's AI" live widget
# If omitted, the "/api/chat" endpoint automatically uses the built-in Portfolio RAG fallback engine.
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEY=your_google_ai_studio_api_key_here
NEXT_PUBLIC_GOOGLE_AI_STUDIO_ENDPOINT=/api/chat
